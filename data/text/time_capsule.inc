TimeCapsule_Text_Intro:
	.string "Welcome to the POKéMON CABLE\n"
	.string "CLUB TIME CAPSULE.\p"
	.string "You can travel to the past and\n"
	.string "trade your POKéMON.$"

@ Said by the attendant before choosing a service, like the
@ WIRELESS CLUB attendant (gText_SorryWirelessClubAdjustments).
TimeCapsule_Text_Closed:
	.string "I'm terribly sorry.\n"
	.string "The TIME CAPSULE is\l"
	.string "undergoing adjustments now.$"

@ Crystal: "Sorry, [MON] can't be taken."
TimeCapsule_Text_RejectSpecies:
	.string "Sorry, {STR_VAR_1} can't be\n"
	.string "taken to the past.\p"
	.string "It didn't exist back then.$"

@ Crystal: "You can't take the [MON] with a [MOVE]."
TimeCapsule_Text_RejectMove:
	.string "You can't take the {STR_VAR_1}\n"
	.string "with a {STR_VAR_2}.\p"
	.string "It didn't exist back then.$"

@ Crystal: "You can't take the [MON] that has MAIL with you."
TimeCapsule_Text_RejectMail:
	.string "You can't take the {STR_VAR_1}\n"
	.string "that has MAIL with you.\p"
	.string "Please take the MAIL off first.$"

TimeCapsule_Text_RejectEgg:
	.string "Sorry, an EGG can't be taken\n"
	.string "to the past.\p"
	.string "Please leave it in the PC first.$"

TimeCapsule_Text_RejectShiny:
	.string "Sorry, this POKéMON can't be\n"
	.string "taken to the past.\p"
	.string "It couldn't exist back then.$"
